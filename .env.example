# ── Resend (Get a Quote form) ─────────────────────────────────────────────
# Server-side only — NOT prefixed with VITE_, so these are never sent to the browser.
# Set the real values in Vercel → Project → Settings → Environment Variables.

# Your Resend API key (https://resend.com/api-keys) — starts with "re_"
RESEND_API_KEY=

# Inbox that should receive quote requests
QUOTE_TO_EMAIL=

# Verified sender. Requires verifying easitchonconstruction.com in Resend first.
# Leave blank while testing to fall back to Resend's onboarding sender.
QUOTE_FROM_EMAIL="E.A. Sitchon Construction <noreply@easitchonconstruction.com>"
